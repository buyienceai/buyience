# Neon Postgres connection string (required when LEADS_BACKEND_URL is unset)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Optional: when set, /api/leads/* proxies to this base instead of writing to Neon.
# Example: https://api.buyience.com  →  POST {LEADS_BACKEND_URL}/api/leads/demo
# LEADS_BACKEND_URL=

# SEO crawl/index signals (robots allow, sitemap, Search Console, JSON-LD).
# Set to "true" ONLY on the real production Vercel environment (buyience.com).
# Leave unset on Preview / stage (buyience.vercel.app) so those deploys stay noindex.
# SEO_INDEXING=true

# Optional fixed public origin for canonicals / sitemap (production):
# NEXT_PUBLIC_SITE_URL=https://buyience.com

# SMTP (Amazon SES) — used to email lead form submissions
# MAIL_MAILER=smtp
# MAIL_HOST=email-smtp.eu-west-2.amazonaws.com
# MAIL_PORT=465
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=no-reply@buyience.com
# MAIL_FROM_NAME=Buyience
# MAIL_TO=hello@buyience.com
# Optional comma-separated CC list:
# MAIL_CC=team@buyience.com,ops@buyience.com

